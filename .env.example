# ==============================================================================
# ☿ MERCURY AUTOMATION ENGINE - CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your tokens, or configure them directly
# via the Mercury Dashboard under 'Credentials & Tokens'.
# ==============================================================================

# Meta Graph API Credentials (Permanent System User Access Token)
PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
PAGE_ID=your_facebook_page_id_here
IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
APP_ID=your_meta_app_id_here

# Webhook Security
WEBHOOK_VERIFY_TOKEN=Mercury_Secret_Verify_Token_2026
PORT=8000

# Community & Profile Customization
IG_USERNAME=your_instagram_handle
DISCORD_INVITE_URL=https://discord.gg/your-community
YOUTUBE_URL=https://youtube.com/@your-channel

# Dashboard Operator Authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ChangeThisPasswordSecurely123!
AUTH_SECRET=Mercury_Auth_Secret_Key_Secure_9988

# Optional Serverless Poller Protection
CRON_SECRET=
CONTACT_EMAIL=support@mercury.local
